<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Testcontainers-backed integration tests. Activates in P02c-2 with the
    first real test (Hub-side internal API endpoint smoke). Until then the
    CI job `backend-integration` is `if: false` and `make test-backend`
    filters this project out.
  -->

  <PropertyGroup>
    <RootNamespace>LearnStack.Hub.Tests.Integration</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Core\LearnStack.Hub.SharedKernel\LearnStack.Hub.SharedKernel.csproj" />
    <ProjectReference Include="..\..\src\Core\LearnStack.Hub.Api\LearnStack.Hub.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Testcontainers" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.Redis" />
    <PackageReference Include="Respawn" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

</Project>
