# LearnStack Hub operator-portal — Next.js local environment.
#
# Copy to `.env.local` in this directory (NOT committed). Next.js reads
# `.env.local` from the **app directory**, not the repo root, so this is a
# narrow mirror of the values from the Hub repo-root `.env.example`.
#
# Variables prefixed `NEXT_PUBLIC_` are inlined into the client bundle at
# build time — never put a secret behind that prefix. Server-only values
# (BFF session keys, Keycloak client secrets) live without the prefix.

# Hub-side API base URL. Operator portal talks to the Hub API through Hub's
# APISIX (port 9180). Production routes through hub.learnstack.dev.
NEXT_PUBLIC_HUB_API_BASE_URL=http://localhost:9180

# Keycloak OIDC discovery — learnstack-hub realm.
# This is the OPERATOR realm; never accept this issuer's tokens on tenant
# surfaces. The realm export lives in
# learnstack/infra/keycloak/realms/learnstack-hub.json.
NEXT_PUBLIC_OIDC_ISSUER=http://localhost:8080/realms/learnstack-hub
NEXT_PUBLIC_OIDC_CLIENT_ID=learnstack-hub-web

# BFF session cookie name (P02c-4 wires the actual NextAuth / Auth.js
# integration; reserved now so P02c-4 only edits one file).
HUB_BFF_SESSION_COOKIE=hub-operator-session

# MFA required (per learnstack-hub realm requiredActions: [CONFIGURE_TOTP]).
# This var documents the expectation; enforcement happens at Keycloak.
HUB_MFA_REQUIRED=true
